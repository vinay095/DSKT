# =============================================================================
# DeskIt backend environment (copy to `.env` and fill in secrets)
# Loaded automatically from the process working directory via DotEnvEnvironmentPostProcessor.
# OS / CI environment variables always win over `.env`.
# =============================================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=local
# Use `dev` when pointing at Supabase shared-dev; `prod` for production hardening.
# SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (local docker-compose PostGIS) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/deskit
DATABASE_USERNAME=deskit
DATABASE_PASSWORD=deskit

# --- Database (Supabase / shared-dev) ---
# Use the DIRECT connection (port 5432), not the pooler, for Flyway DDL.
# DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=<supabase-database-password>
# DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_HOST=localhost
# Host-mapped port from backend/docker-compose.yml
REDIS_PORT=6380
REDIS_PASSWORD=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- JWT (HS256, >= 32 characters) ---
APP_JWT_SECRET=change-me-deskit-phase1-jwt-secret-key-32b-min

# --- Auth / SSO ---
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Shared-dev: set true only if you need seeded /api/v1/auth/dev-login
DESKIT_DEV_LOGIN_ENABLED=false

# OIDC_ENTRA_CLIENT_ID=
# OIDC_ENTRA_CLIENT_SECRET=
# OIDC_ENTRA_TENANT_ID=
# OIDC_OKTA_CLIENT_ID=
# OIDC_OKTA_CLIENT_SECRET=
# OIDC_OKTA_ISSUER_URI=
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# --- Phase 5 / 6 ops ---
DESKIT_POSTGIS_SYNC_ENABLED=true
DESKIT_RATE_LIMIT_ENABLED=true
DESKIT_RATE_LIMIT_RPM=120
DESKIT_RATE_LIMIT_AUTH_RPM=20
DESKIT_OPENAPI_PUBLIC=true
DESKIT_PROMETHEUS_PUBLIC=false

# --- Supabase Storage (catalog SVG assets; service role only — never expose to browser) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET_CATALOG=catalog-assets

# Rebuild shared-dev schema: scripts/supabase-dev/01_stage_legacy.sql → start API → 02_backfill...
